def _cmd_compact(store: Store, args: list[str]) -> int:
    if not args:
        print("usage: qq compact <topic> [keep-N=5]", file=sys.stderr)
        return 2
    topic = args[0]
    n_raw = args[1] if len(args) > 1 else "5"
    try:
        keep_n = int(n_raw)
    except ValueError:
        # JUDGMENT CALL (flagged for review): legacy passed keep-N to awk UNVALIDATED — a
        # non-numeric N coerces to 0 in awk's `keep=(u<=N)` and silently drops EVERY
        # update-line (while the `[ "$ul" -le "$n" ]` short-circuit errors past itself under
        # set -e semantics). That's a data-losing bash artifact, not a behavior to reproduce;
        # refused here with the dispatcher's usual clean exit-2 usage error.
        print(f"qq compact: keep-N must be an integer (got '{n_raw}') – "
              f"usage: qq compact <topic> [keep-N=5]", file=sys.stderr)
        return 2
    try:
        sys.stdout.write(writemod.compact(store, topic, keep_n))
    except writemod.WriteError as e:
        print(str(e), file=sys.stderr)
        return e.exit_code
    return 0


def _delegate_direct(cmd: str, args: list[str]) -> "None":
    """search/ask: exec qq-search/qq-ask DIRECTLY (see _DIRECT_EXEC's comment for why this must
    NOT go through qq-legacy) — same argv shape qq-legacy's own `search)`/`ask)` cases would
    have passed (cmd's own argv[0] already stripped), UNTOUCHED environment (no env= override:
    the whole point is that qq-search/qq-ask see the real process environment, not one qq-legacy
    has mutated)."""
    target = os.path.join(ENGINE, _DIRECT_EXEC[cmd])
    try:
        os.execv(target, [target] + args)
    except OSError as e:
        print(f"qq: cannot exec {_DIRECT_EXEC[cmd]} ({target}): {e}", file=sys.stderr)
        sys.exit(1)


