def _cmd_rewrite(store: Store, args: list[str]) -> int:
    if not args:
        print("usage: qq rewrite <topic> < full_content", file=sys.stderr)
        return 2
    topic = args[0]
    rest = args[1:]
    allow_future = False
    if "--allow-future" in rest:
        allow_future = True
        rest = [a for a in rest if a != "--allow-future"]
    consumed = _consume_ref_flags(rest, "rewrite")
    if consumed is None:
        return 2
    _, refs = consumed   # any OTHER further argv is silently ignored, matching qq-legacy's own case
    content = _read_stdin_text()
    try:
        sys.stdout.write(writemod.rewrite(store, topic, content, refs=refs, allow_future=allow_future))
    except writemod.WriteError as e:
        print(str(e), file=sys.stderr)
        return e.exit_code
    return 0


