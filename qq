def verb_help(cmd: str) -> str:
    """Per-verb usage line (for `qq <verb> --help` / a refused dash-object); full usage as fallback."""
    u = _VERB_USAGE.get(cmd)
    return (u + "\n") if u else cli.render_usage()


def main() -> int:
    argv = sys.argv[1:]
    cmd = argv[0] if argv else "menu"
    args = argv[1:] if argv else []

    if cmd not in NATIVE_VERBS:
        if cmd in _DIRECT_EXEC:
            _delegate_direct(cmd, args)   # search/ask: straight to qq-search/qq-ask, never qq-legacy
        # Unknown command: same shape + exit code as legacy's `*)` case (message, usage to
        # stderr, exit 2) — rendered natively; qq-legacy is off every dispatch path since P9.
        print(f"qq: unknown command '{cmd}'", file=sys.stderr)
        sys.stderr.write(cli.render_usage())
        return 2

    if cmd in ("help", "-h", "--help"):
        sys.stdout.write(cli.render_usage())
        return 0

    # A `-h`/`--help` anywhere in a verb's ARGUMENTS (before any `--` text separator) is a help
    # request for that verb, not a topic/dir/value — render its help instead of letting the verb
    # swallow it as a positional (the `qq init --help` footgun, and the same for every verb).
    sep_h = args.index("--") if "--" in args else len(args)
    if any(a in ("-h", "--help") for a in args[:sep_h]):
        sys.stdout.write(verb_help(cmd))
        return 0

    # A `-`/`--`-prefixed token in an OBJECT slot (dir / subcommand for the admin verbs here) is a
    # mistyped flag, never a real object — refuse it rather than, e.g., create a store dir named
    # "--help". Store verbs are guarded the same way after the --global strip (below).
    # `init --project` is a REAL first-position flag, so it is exempt —
    # without this the guard refuses the only supported way to create a project store.
    if cmd in ("init", "config") and args and args[0].startswith("-") \
            and args[0] not in _ADMIN_FIRST_FLAGS.get(cmd, ()):
        _obj = "directory" if cmd == "init" else "subcommand"
        print(f"qq {cmd}: '{args[0]}' looks like a command-line flag, not a {_obj} – refusing to "
              f"treat it as one.", file=sys.stderr)
        sys.stderr.write(verb_help(cmd))
        return 2

    # doctor/config/init (quintessence.admin): dispatched BEFORE the --global strip and store
    # resolution — they operate on the CONFIG layer (or scaffold a store that doesn't exist
    # yet), never on a resolved store, and their argv must arrive untouched (a `config set`
    # VALUE containing "--global" is data, not a routing flag). Matches legacy, where these
    # three delegated straight through with no store context.
    if cmd == "doctor":
        rc, text = adminmod.doctor(Config(), ENGINE)
        sys.stdout.write(text)
        return rc

    if cmd == "init":
        try:
            out, err = adminmod.init(Config(), args)
        except adminmod.AdminError as e:
            print(str(e), file=sys.stderr)
            return e.exit_code
        sys.stdout.write(out)
        sys.stderr.write(err)
        return 0

    if cmd == "config":
        rc, out, err = adminmod.config_cmd(Config(), args)
        sys.stdout.write(out)
        sys.stderr.write(err)
        return rc

    # `--global`/`-g`: force the user store — reach the shared user-level
    # store explicitly from inside a project. A new flag, so stripping it can't change any
    # existing invocation; a no-op when there is no project store (user == write-target).
    # The strip STOPS at the first `--`: everything after it is literal text by the write verbs'
    # own documented contract ("use -- before text starting with --"), so a `--global`/`-g`
    # there must be recorded, not swallowed as the flag.
    sep = args.index("--") if "--" in args else len(args)
    global_flag = any(a in ("--global", "-g") for a in args[:sep])
    args = [a for a in args[:sep] if a not in ("--global", "-g")] + args[sep:]

    # `--unredacted` for show/load/brief: lifts the withheld-topics refusal for a limited
    # reader session.  Stripped here (before the object-first guard) so it doesn't look like
    # a mistyped topic.
    unredacted_flag = False
    if cmd in ("show", "load", "brief") and "--unredacted" in args:
        unredacted_flag = True
        args = [a for a in args if a != "--unredacted"]

    # Object-slot dash guard for store verbs: with --global/-g stripped, a leading `-`/`--` in the
    # topic position is a mistyped flag (--ref/--allow-future are flag-position args AFTER the
    # topic). Refuse rather than create/act on a HEAD named "--foo". `--` still introduces literal text.
    if cmd in _OBJECT_FIRST_STORE and args and args[0].startswith("-"):
        print(f"qq {cmd}: '{args[0]}' looks like a command-line flag, not a topic – refusing to "
              f"treat it as one.", file=sys.stderr)
        sys.stderr.write(verb_help(cmd))
        return 2

    config = Config()
    # Multi-store resolution. SINGLE-STORE PATH IS BYTE-IDENTICAL TO PRE-P2: we build a
    # bare Store(config) and route every verb to it, exactly as before. Only a genuine >=2-store
    # search path (a project store discovered on the walk-up) activates composition.
    storepath = resolve_store_path(config=config)
    if len(storepath.path) == 1:
        store = write_store = user_store = Store(config)
        read_store = store
    else:
        # A project store keeps its atomic-fact memory under its own root
        # (<project>/.quintessence/memory); the user store uses the Config QQ_MEMDIR.
        stores = [Store(config, qdir=loc.qdir,
                        memdir=(loc.memdir if loc.kind == "project" else None))
                  for loc in storepath.path]
        write_store = stores[0]          # most-specific: write target + LIST/digest scope
        user_store = stores[-1]          # the shared user store (search-path tail)
        read_store = CompositeStore(stores)   # FETCH verbs resolve across the whole path
        store = write_store
        if global_flag:                  # --global: everything against the user store
            store = write_store = read_store = user_store

    if cmd in ("menu", "index"):
        sys.stdout.write(cli.render_menu(store))
        return 0

    if cmd == "digest":
        sys.stdout.write(cli.render_digest(store, config, _findings_file(config)))
        return 0   # ratified deviation from qq-legacy — see cli.render_digest's docstring

    if cmd == "findings":
        sub = args[0] if args else ""
        if sub == "next":
            sys.stdout.write(cli.render_findings_next(store, config, _findings_file(config)))
            return 0
        if sub in ("", "list"):
            sys.stdout.write(cli.render_findings_list(_findings_file(config)))
            return 0
        print("usage: qq findings [next|list]", file=sys.stderr)
        return 2

    if cmd == "list":
        # union slug dump across the search path (tooling surface); menu/digest stay
        # project-scoped as the human orientation surfaces.
        sys.stdout.write(cli.render_list(read_store))
        return 0

    if cmd == "path":
        if not args:
            print("usage: qq path <topic>", file=sys.stderr)
            return 2
        # FETCH verb: resolve the named topic across the search path (project shadows user).
        sys.stdout.write(cli.render_path(read_store, args[0]))
        return 0

    if cmd == "memdir":
        # write-target store's memory dir (project's <root>/.quintessence/memory inside a project,
        # else the user QQ_MEMDIR); --global forces the user store. store == write_store here.
        sys.stdout.write(cli.render_memdir(store))
        return 0

    if cmd == "fact":
        # READ-ONLY viewer for an atomic memory fact (the `qq fact <name>` a search hit shows).
        # Distinct from `show` (HEADs) so the model never generalises to `qq update <fact>`.
        if not args:
            print("usage: qq fact <name>", file=sys.stderr)
            return 2
        sys.stdout.write(cli.render_fact(store, args[0]))
        return 0

    if cmd in ("show", "load"):
        if not args:
            print("usage: qq show <topic> [topic2 ...] [--unredacted]", file=sys.stderr)
            return 2
        allowed = _show_redact_gate(config, cmd, args, unredacted_flag)
        if allowed:
            sys.stdout.write(cli.render_show(read_store, allowed))
        return 0 if allowed == args else 1

    if cmd == "brief":
        if not args:
            print("usage: qq brief <topic> [topic2 ...] [--unredacted]", file=sys.stderr)
            return 2
        allowed = _show_redact_gate(config, "brief", args, unredacted_flag)
        if allowed:
            sys.stdout.write(cli.render_brief(read_store, allowed))
        return 0 if allowed == args else 1

    if cmd == "check":
        return _cmd_check(config, store, read_store, args)

    if cmd == "reconcile":
        return _cmd_reconcile(config, args)

    if cmd == "waveoff":
        return _cmd_waveoff(config, args)

    # Cross-store write guard (multi-store): a write verb targets ONLY the write store, but the
    # fetch verbs compose — so "qq show <topic> works, qq update <topic> fails/creates" is the
    # trap in the gap. Worst case is `rewrite`, whose REPLACE mode has no missing-file guard: it
    # would silently CREATE a project-local fork that then shadows the user HEAD for every read
    # here. Refuse with the two real options instead. Inert in the degenerate case and under
    # --global (write_store IS read_store, the condition can't hold).
    # delete/rm/compact joined this guard when they went native (P9): as STORE_SCOPED_LEGACY
    # delegates they were env-pinned to the project store and failed with a bare "no HEAD" —
    # same refuse-don't-act outcome, now with the guard's two-real-options message. (reindex
    # takes no topic, so it routes like list/digest: the write store, nothing to guard.)
    if cmd in ("update", "essence", "rewrite", "finalize", "save", "checkpoint",
               "delete", "rm", "compact") and args:
        topic = args[0]
        if not write_store.has_head(topic) and read_store.has_head(topic):
            print(f"qq {cmd}: HEAD '{topic}' exists in the user store, not in this project's "
                  f"store.", file=sys.stderr)
            print(f"  write it there instead:      qq {cmd} {topic} ... --global", file=sys.stderr)
            print(f"  or start a project HEAD:     qq new {topic}   "
                  f"(shadows the user HEAD for reads here)", file=sys.stderr)
            return 1

    if cmd == "update":
        return _cmd_update(store, args)

    if cmd == "essence":
        return _cmd_essence(store, args)

    if cmd == "new":
        # Deliberate creation is allowed to shadow — but say so, once, at creation time.
        if args and not write_store.has_head(args[0]) and read_store.has_head(args[0]):
            print(f"qq new: note – '{args[0]}' also exists in the user store; the new project "
                  f"HEAD will shadow it for reads inside this project (--global reaches the "
                  f"user one).", file=sys.stderr)
        return _cmd_new(store, args)

    if cmd == "rewrite":
        return _cmd_rewrite(store, args)

    if cmd in ("finalize", "save", "checkpoint"):
        return _cmd_finalize(store, args)

    if cmd == "reindex":
        return _cmd_reindex(store)

    if cmd in ("delete", "rm"):
        return _cmd_delete(store, args)

    if cmd == "compact":
        return _cmd_compact(store, args)

    raise AssertionError(f"unreachable: {cmd!r} in NATIVE_VERBS with no handler")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except StorePathError as e:
        # Traversal guard (store.py): a `../`-shaped topic reaching a read verb (show/brief/path)
        # or essence/finalize surfaces here — the write verbs already return 2 via their own
        # WriteError handling. Clean exit 2, never a traceback.
        print(str(e), file=sys.stderr)
        sys.exit(2)
    except BrokenPipeError:
        # A native verb's output piped into something that closes early (`qq menu | head`,
        # `qq digest | head -1`, a hook capturing partial output) must die quietly, matching
        # qq-legacy's bash behavior under the SAME SIGPIPE (bash just exits 141, no message) —
        # not a Python traceback + exit 1. Redirect stdout to /dev/null first so the
        # interpreter's own shutdown-time flush doesn't raise a SECOND BrokenPipeError.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(141)   # 128 + SIGPIPE(13), the exit code a SIGPIPE-killed process reports
