def _load_redact_entries(path: str) -> list:
    """Load the withheld-topics list, same parse as search.py's _redact_entries."""
    try:
        with open(path) as f:
            raw = f.read().splitlines()
    except OSError:
        return []
    out = []
    for ln in raw:
        ln = re.sub(r"\s+#.*$", "", ln).strip()
        if ln and not ln.startswith("#"):
            out.append(ln)
    return out


def _topic_redacted(topic: str, entries: list) -> bool:
    """Does `topic` match a withheld-topics entry?  Trailing '*' = prefix match,
    else exact slug match — the same matching the search-side redaction uses for
    a bare slug (no path-substring branch, since show/brief targets are always slugs)."""
    base = topic.rsplit("/", 1)[-1]
    if base.endswith(".md"):
        base = base[:-3]
    for e in entries:
        if e.endswith("*"):
            if base.startswith(e[:-1]):
                return True
        elif base == e:
            return True
    return False


def _show_redact_gate(config, cmd: str, topics: list, unredacted: bool) -> list:
    """Withheld-topics refusal for show/brief on a limited reader session.  Returns
    the list of topics that are ALLOWED to render.  For each refused topic, prints a
    refusal to stderr naming the topic and the override.  A full-access reader, an
    unconfigured install, and a lifted override all pass through unchanged."""
    if unredacted or config.get_bool("QQ_SHOW_UNREDACTED"):
        return topics
    redact_file = config.get_path("QQ_REDACT_FILE")
    entries = _load_redact_entries(redact_file)
    if not entries:
        return topics
    mode = authgate.model_mode(config)
    if mode == "opus":
        return topics
    allowed = []
    for t in topics:
        if _topic_redacted(t, entries):
            print(f"qq {cmd}: '{t}' is on the withheld-topics list and this session's "
                  f"reader profile ({mode}) does not have full access – refusing to "
                  f"render. Override: qq {cmd} {t} --unredacted  or  "
                  f"QQ_SHOW_UNREDACTED=1 qq {cmd} {t}", file=sys.stderr)
        else:
            allowed.append(t)
    return allowed


