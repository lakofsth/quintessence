# search/ask (recall composition): these two are ALREADY fully owned by the python
# engine (quintessence.search/quintessence.ask via qq-search/qq-ask) and are direct-exec'd here
# instead of relayed through qq-legacy's `search)`/`ask)` cases (which are themselves nothing
# but `exec "$ENGINE/qq-search" "$@"`/`exec "$ENGINE/qq-ask" "$@"` — a pure pass-through).
# GROUNDED BUG this fixes (found while building P8's parity test): qq-legacy sources
# qq-config.sh on EVERY invocation, and qq-config.sh's `_qq_load_config` EXPORTS every
# dotenv-config-file key — including QUINTESSENCE_DIR — into the process environment for its
# OWN internal use ("env wins: set only if not already set") before ever reaching the
# `search)`/`ask)` case. That export then leaks into the exec'd qq-search/qq-ask CHILD's
# environment as a genuine env var, and quintessence.storepath.resolve_store_path can no longer
# tell a FILE-recorded QUINTESSENCE_DIR (must NOT pin — `qq init` records
# the user store there and per-project discovery must keep running) from a real env pin —
# silently disabling multi-store composition for every `qq search`/`qq ask` call that went
# through qq-legacy. Direct-execing skips qq-legacy's bootstrap entirely, so the artifact export
# never happens; qq-search/qq-ask resolve their own Config from the UNTOUCHED process
# environment, exactly as a direct `qq-search`/`qq-ask` invocation always has.
_DIRECT_EXEC = {"search": "qq-search", "ask": "qq-ask"}


def _findings_file(config: Config) -> FindingsFile:
    path = os.path.join(config.get_path("QQ_STATE_DIR"), "pending-findings.md")
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return FindingsFile.parse(fh.read())
    except OSError:
        return FindingsFile()


def _cmd_check(config: Config, store: Store, resolver_store, args: list[str]) -> int:
    """Port of qq-legacy `check)`: fast T1 (quintessence.checks + quintessence.reconcile,
    merged into the TIER1 section) first, then the slow T2 xref (quintessence.xref).

    In `--write` mode, the flag-only "[T1 index] ... run `qq reindex`" finding
    `Checks.tier1_findings()` always produces (checks.py stays L2/read-only by design — see its
    module docstring) is substituted here for the REAL git-tree auto-fix attempt
    (`quintessence.write.index_autofix_finding`, the ONE sanctioned auto-fix `qq check --write`
    performs) — matching run_check's own section 7, which only reindexes+commits when `write`
    mode is active. The substitution is by Finding identity (cls="T1 index", kind="stale"), not
    position, so it's correct regardless of where run_check's own emission order puts it."""
    write = any(a in ("--write", "-w") for a in args)
    skip_xref = config.get_bool("QQ_XREF_DISABLE") or any(a in ("--fast", "--no-xref") for a in args)

    # The FILE-checks (head-meta, mem-health, MEMORY.md bijection) run over `store` —
    # the write-target (project) store, checking its OWN files. But link resolution uses
    # `resolver_store` — the COMPOSITE read view — so a project HEAD's `[[user-topic]]` link
    # resolves against the whole search path instead of being false-flagged as unresolved
    # (project shadows user in the composite's deduped slug set, so no false ambiguity either).
    # Degenerate: resolver_store IS store, so this is byte-identical to pre-P5.
    resolver = SlugResolver(resolver_store)
    findings = Checks(config, store, resolver).tier1_findings()
    if write:
        replaced: list[Finding] = []
        for f in findings:
            if f.cls == "T1 index" and f.fields.get("kind") == "stale":
                fixed = writemod.index_autofix_finding(store)
                if fixed is not None:
                    replaced.append(fixed)
            else:
                replaced.append(f)
        findings = replaced
    findings += [Finding(cls="T1 config-drift", text=ln)
                 for ln in Reconcile(config).run(commit=write)]
    tier1_lines = [f.render() for f in findings]

    # None = xref skipped OR failed (both are indistinguishable to qq-legacy's own caller — a
    # transient embedder outage produces no stdout before the exception, exactly like a
    # deliberate --fast skip); a list (possibly empty) = it ran to completion.
    xref_lines: Optional[list[str]] = None
    if not skip_xref:
        try:
            xref_lines = [f.render() for f in Xref(config, SearchIndex(config)).finding_records()]
        except Exception:
            # Matches qq-legacy: `xout="$(staleness-xref.py)" && xok=1` — ANY nonzero exit
            # (embedder down, index incomplete, etc.) is indistinguishable from "produced
            # nothing" to the caller; --write leaves the XREF section untouched (xref_lines
            # stays None), never silently clearing real findings on a transient failure.
            xref_lines = None

    if write:
        persist_findings(store, tier1_lines, xref_lines)
        path = os.path.join(config.get_path("QQ_STATE_DIR"), "pending-findings.md")
        xcount = len(xref_lines) if xref_lines is not None else None
        sys.stdout.write(cli.render_check_write_summary(len(tier1_lines), xcount, path))
    else:
        sys.stdout.write(cli.render_check_readonly(tier1_lines, xref_lines or [], skip_xref))
    return 0


def _cmd_reconcile(config: Config, args: list[str]) -> int:
    """Port of qq-legacy `reconcile)`: config-drift only, read-only by default. The friendlier
    top-level "no registry" message is qq-legacy's own (distinct from Reconcile.run's internal
    --explain-only diagnostic, which stays silent without --explain)."""
    reconcile = Reconcile(config)
    if not reconcile.registry or not os.path.isfile(reconcile.registry):
        print("qq reconcile: no registry (set QQ_RECONCILE_REGISTRY to an INI) – nothing to check.")
        return 0
    for line in reconcile.run(explain="--explain" in args, commit="--commit-snapshot" in args):
        print(line)
    return 0


def _cmd_waveoff(config: Config, args: list[str]) -> int:
    """Port of qq-legacy `waveoff)`: adjudicate a [T2 stale?] pair (or bulk-clear a HEAD's)."""
    xref = Xref(config, SearchIndex(config))
    if args and args[0] == "--head":
        if len(args) < 2:
            print("usage: qq waveoff --head <head-topic> [--all]", file=sys.stderr)
            return 1
        try:
            print(xref.waveoff_head_all(args[1]))
        except RuntimeError as e:
            # PRE-EXISTING wart, discovered (not introduced) by this P4 wiring: bulk waveoff
            # needs the embedding index (unlike the single-pair path below), so an
            # embedder-down/empty-corpus RuntimeError from Xref.pair_sims would otherwise
            # surface as a raw Python traceback here — staleness-xref.py's own standalone CLI
            # has the identical gap (verified: same uncaught RuntimeError, same traceback).
            # Flagged for review; degrading to a clean message here rather than propagating.
            print(f"qq waveoff --head: {e}", file=sys.stderr)
            return 1
        return 0
    if len(args) != 2:
        print("usage: qq waveoff <memory> <head>  |  qq waveoff --head <head> [--all]", file=sys.stderr)
        return 2
    try:
        print(xref.waveoff(args[0], args[1]))
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 1
    return 0


def _read_stdin_text() -> str:
    """Raw stdin, decoded UTF-8/errors=replace — matches how the rest of the package already
    treats store text (heads.py/store.py's own convention); qq-write itself is byte-agnostic
    (`cat > "$tmp"`), but every downstream consumer here (Head parsing, the H1/shrink-guard
    comparisons) works on `str`."""
    return sys.stdin.buffer.read().decode("utf-8", errors="replace")


def _consume_prepend_flags(rest: list[str]) -> "Optional[tuple[list[str], list[str]]]":
    """Port of qq-legacy `update)`'s own flag-scanning loop: tolerate a leaked
    `--prepend-update` (an internal qq-write flag some old habits still pass — a no-op here,
    `update` always prepends), `--` ends scanning (everything after is literal text, even if it
    starts with dashes), any OTHER `--*` is a hard error (rather than silently becoming literal
    text while real stdin is discarded — the exact bug class test-write-surface.sh guards), and
    a bare (non `--`-prefixed) word stops scanning — it and everything after is the text.
    Returns None (having already printed the error) on the hard-error case.

    B1 addition: `--ref kind:id` / `--ref=kind:id` (repeatable, reality binding's explicit-ref
    flag) is consumed here too — flag-position only, so a `--ref` after `--` stays literal text
    per the existing contract. Returns (text_args, ref_args)."""
    refs: list[str] = []
    i = 0
    n = len(rest)
    while i < n:
        a = rest[i]
        if a == "--prepend-update":
            i += 1
            continue
        if a == "--ref":
            if i + 1 >= n:
                print("qq update: --ref needs a value (kind:id)", file=sys.stderr)
                return None
            refs.append(rest[i + 1])
            i += 2
            continue
        if a.startswith("--ref="):
            refs.append(a[len("--ref="):])
            i += 1
            continue
        if a == "--":
            return rest[i + 1:], refs
        if a.startswith("--"):
            print(f"qq update: unexpected flag '{a}' – usage: qq update <topic> \"text\"  "
                  f"|  echo text | qq update <topic>  (use -- before text starting with --)",
                  file=sys.stderr)
            return None
        break
    return rest[i:], refs


def _consume_ref_flags(rest: list[str], verb: str) -> "Optional[tuple[list[str], list[str]]]":
    """Leading `--ref kind:id` / `--ref=kind:id` flags for the verbs that don't share update's
    flag loop (essence/new/rewrite). Flag-position only, same as every other write-verb flag;
    a valueless `--ref` is a usage error (argv malformation, not a binding failure — fail-soft
    starts INSIDE bind_write, not at the command line). Returns (remaining_args, refs), or
    None after printing the error."""
    refs: list[str] = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--ref":
            if i + 1 >= len(rest):
                print(f"qq {verb}: --ref needs a value (kind:id)", file=sys.stderr)
                return None
            refs.append(rest[i + 1])
            i += 2
            continue
        if a.startswith("--ref="):
            refs.append(a[len("--ref="):])
            i += 1
            continue
        break
    return rest[i:], refs


def _cmd_update(store: Store, args: list[str]) -> int:
    if not args:
        # JUDGMENT CALL (flagged for review): legacy's `${1:?usage: ...}` exits 1 with a
        # bash-internal diagnostic (embeds ITS OWN line number, not meaningful ported verbatim);
        # every other usage error in THIS dispatcher (show/brief/path/waveoff, and essence/new/
        # rewrite/finalize below) already uses exit 2 with a clean message — matched here for
        # consistency within the python dispatcher rather than replicating a bash artifact.
        print("usage: qq update <topic> [text...]", file=sys.stderr)
        return 2
    topic, rest = args[0], args[1:]
    consumed = _consume_prepend_flags(rest)
    if consumed is None:
        return 2
    text_args, refs = consumed
    content = " ".join(text_args) + "\n" if text_args else _read_stdin_text()
    try:
        sys.stdout.write(writemod.update(store, topic, content, refs=refs))
    except writemod.WriteError as e:
        print(str(e), file=sys.stderr)
        return e.exit_code
    return 0


def _cmd_essence(store: Store, args: list[str]) -> int:
    if not args:
        print("usage: qq essence <topic> <text...>", file=sys.stderr)
        return 2
    topic, rest = args[0], args[1:]
    consumed = _consume_ref_flags(rest, "essence")
    if consumed is None:
        return 2
    rest, refs = consumed
    if rest and rest[0] == "--":
        rest = rest[1:]
    elif rest and rest[0].startswith("--"):
        print(f"qq essence: unexpected flag '{rest[0]}' – usage: qq essence <topic> <text...>  "
              f"(use -- before text starting with --)", file=sys.stderr)
        return 2
    if not rest:
        print("usage: qq essence <topic> <text...>", file=sys.stderr)
        return 2
    try:
        sys.stdout.write(writemod.essence(store, topic, " ".join(rest), refs=refs))
    except writemod.WriteError as e:
        print(str(e), file=sys.stderr)
        return e.exit_code
    return 0


